# README 표 자동 갱신 (선택 사항 — 기본 비활성)
#
# 켜려면 이 파일 이름에서 `.disabled`를 떼서 update-readme.yml 로 바꾸세요.
# 켜면 push할 때마다 표를 다시 만들고 "docs: update README table" 봇 커밋이 하나씩 추가됩니다.
# 커밋 로그를 깔끔하게 유지하고 싶으면 그냥 로컬에서 `python scripts/update_readme.py`를 돌리세요.

name: Update README

on:
  push:
    branches: [main]
    paths:
      - "leetcode/**"
      - "programmers/**"
      - "scripts/update_readme.py"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Regenerate README table
        run: python scripts/update_readme.py

      - name: Commit if changed
        run: |
          if [[ -n "$(git status --porcelain README.md)" ]]; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add README.md
            git commit -m "docs: update README table"
            git push
          else
            echo "No changes."
          fi
